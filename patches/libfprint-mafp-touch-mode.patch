diff --git a/libfprint/drivers/mafpmoc/mafpmoc.c b/libfprint/drivers/mafpmoc/mafpmoc.c
index 179c137..36d6c61 100644
--- a/libfprint/drivers/mafpmoc/mafpmoc.c
